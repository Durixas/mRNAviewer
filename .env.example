# Copy to .env (ignored by Git), edit, then run: source .env
export MRNAVIEWER_BACKEND_PYTHON=/path/to/bart_old/bin/python
export MRNAVIEWER_UTR5_PYTHON=/path/to/dna/bin/python
export MRNAVIEWER_UTR3_PYTHON=/path/to/dna/bin/python
export MRNAVIEWER_RNAFOLD_BIN=/path/to/RNAfold
export MRNAVIEWER_BLASTN_BIN=/path/to/blastn
export MRNAVIEWER_GS_BIN=/path/to/gs
export MRNAVIEWER_BIND=127.0.0.1:5000
export MRNAVIEWER_RESULT_RETENTION_SECONDS=86400
# Optional; default is the restored database within this repository.
# export MRNAVIEWER_MIRBASE_DB_DIR=/path/to/miRBase/releases/23.1
