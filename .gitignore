workspace/codon/output/
workspace/blast/query*.fa
workspace/blast/output/
workspace/rnafold/input.txt
workspace/rnafold/output/
workspace/gen_image/input.txt
workspace/gen_image/output/
*.out
*.log
*.tmp
*.ps
*.copying

